{
  "manifest_version": 3,
  "name": "OctoLens — Similar Repos for GitHub",
  "version": "1.2.2",
  "description": "Shows similar repositories, quick stats, clone shortcuts, hovercards and bookmarks on every GitHub repository page.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "commands": {
    "toggle-strip": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Collapse or expand the OctoLens strip"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "OctoLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
